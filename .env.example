# Public settings bundled into the native and web clients.
EXPO_PUBLIC_ASSISTANT_API_URL=https://your-vercel-project.vercel.app/api/assistant
EXPO_PUBLIC_CONVERSATION_PROCESSING_API_URL=https://your-vercel-project.vercel.app/api/process-conversation
EXPO_PUBLIC_MEMORY_PROCESSING_API_URL=https://your-vercel-project.vercel.app/api/process-memory
EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key

# Server-only Vercel Function settings.
OPENAI_API_KEY=
# Required even for native requests. Use the web client's exact origin (no path).
ALLOWED_ORIGIN=https://your-web-app.example
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-key
